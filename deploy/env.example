# .env для docker compose (в репозиторий не кладётся)
TAG=latest
CH_DATABASE_URL=postgresql+asyncpg://compilehub:PASSWORD@host.docker.internal:5432/compilehub
CH_JWT_SECRET=сгенерировать: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
CH_PUBLIC_URL=https://compilehub.ru
CH_SMTP_HOST=mail.deev.su
CH_SMTP_PORT=587
CH_SMTP_USER=no-reply@compilehub.ru
CH_SMTP_PASSWORD=
CH_MAIL_FROM=CompileHub <no-reply@compilehub.ru>
REDIS_API_PASSWORD=
REDIS_WORKER_PASSWORD=
